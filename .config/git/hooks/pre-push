#!/bin/sh
while read -r _ local_sha _ remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  case "$remote_sha" in
    *[!0]*) range="$remote_sha..$local_sha" ;;
    *) range="$local_sha --not --remotes" ;;
  esac
  betterleaks git --log-opts="$range" --redact --verbose --no-banner || exit 1
done
