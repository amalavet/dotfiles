{
  "theme": "tokyonight",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "medium",
  "externalEditor": "nvim",
  "quietStartup": true,
  "packages": [
    "npm:pi-vimmode",
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:@juanibiapina/pi-tokyonight@1.1.0",
    "git:github.com/grafana/ai-kit",
    {
      "source": "git:github.com/grafana/skills",
      "skills": [
        "-skills/grafana-app-sdk/admission-control",
        "-skills/grafana-app-sdk/app-sdk-concepts",
        "-skills/grafana-app-sdk/cue-kind-definition",
        "-skills/grafana-app-sdk/reconciler-logic",
        "-skills/grafana-core/promql",
        "-skills/grafana-k6/k6-docs",
        "-skills/grafana-plugins/grafana-scenes",
        "-skills/grafana-plugins/plugin-bundle-size",
        "-skills/grafana-plugins/react-19-plugin-migration"
      ]
    },
    "npm:@oipsanthony/pi-session-title",
    "npm:@benvargas/pi-openai-fast",
    "npm:pi-esc-steer",
    {
      "source": "git:github.com/redhat-et/ripwire@v0.6.5",
      "prompts": [],
      "skills": [
        "skills/ripwire-*",
        "!skills/ripwire-opt-remarks"
      ]
    },
    "~/GitHub/pi-reply-guard",
    "npm:@aliou/pi-processes",
    "npm:@tintinweb/pi-tasks",
    "npm:@gotgenes/pi-permission-system"
  ],
  "lastChangelogVersion": "1.3.0",
  "terminal": {
    "hyperlinks": true
  },
  "tuiMode": "regular",
  "outputPad": 0,
  "httpIdleTimeoutMs": 30000,
  "retry": {
    "maxRetries": 10
  }
}